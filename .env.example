APP_BASE_URL=http://localhost:3000
SOURCE_CODE_URL=https://github.com/bigshit11elf/lutrafin
APP_BIND=127.0.0.1
APP_PORT=3000
DATABASE_PATH=/data/app.db
JELLYFIN_URL=http://192.168.178.20:8096
JELLYFIN_TOKEN_FILE=/run/secrets/jellyfin_token
JELLYFIN_EXCLUDED_LIBRARY_IDS=
TMDB_API_TOKEN_FILE=/run/secrets/tmdb_api_token
TVMAZE_ENABLED=true
TVDB_ENABLED=false
SYNC_INTERVAL=6h
METADATA_REFRESH_INTERVAL=24h
LOG_LEVEL=info
ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=/run/secrets/admin_password
# Optional notification secret files if mounted into the container:
# NTFY_TOKEN_FILE=/run/secrets/ntfy_token
# GOTIFY_TOKEN_FILE=/run/secrets/gotify_token
# PUSHOVER_USER_KEY_FILE=/run/secrets/pushover_user_key
# PUSHOVER_APPLICATION_TOKEN_FILE=/run/secrets/pushover_application_token
# WEBHOOK_URL_FILE=/run/secrets/webhook_url
PIDS_LIMIT=256
MEMORY_LIMIT=512m
