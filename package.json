{
  "name": "lutrafin",
  "version": "0.2.58",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:zip": "bash scripts/create-release-zip.sh",
    "release:check-secrets": "bash scripts/check-release-secrets.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/server/infrastructure/database/migrate.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.27.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.3",
    "svelte": "^5.39.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
